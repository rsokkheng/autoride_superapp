rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Ride chat image attachments (chat_images/{chatId}/{fileName}) — only
    // the two people in that Firestore chat. See firestore.rules for how
    // app_uid is issued.
    match /chat_images/{chatId}/{fileName} {
      function isParticipant() {
        return request.auth != null
          && request.auth.token.app_uid is int
          && request.auth.token.app_uid in [
               firestore.get(/databases/(default)/documents/chats/$(chatId)).data.driver_id,
               firestore.get(/databases/(default)/documents/chats/$(chatId)).data.passenger_id,
             ];
      }

      allow read: if isParticipant();
      allow create: if isParticipant()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Block everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
