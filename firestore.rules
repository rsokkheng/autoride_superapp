rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Driver live GPS location
    match /drivers_live/{driverId} {
      allow read, write: if request.auth != null;
    }

    // Ride chat conversations (keyed by ride_id inside the document)
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    // Individual chat messages (chat_id field references a chats document)
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Block everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
